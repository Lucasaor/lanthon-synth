# =============================================================================
# lanth0n-cpugov.service — Set CPU governor to performance on boot
# =============================================================================
# Sets all CPU cores to the 'performance' governor before the playback
# engine starts. This is REQUIRED for low-latency audio — the default
# 'ondemand' governor causes xruns when the CPU momentarily downclocks.
#
# Uses a Type=oneshot service that exits after setting, via Before= ordering
# in lanthon-engine.service. Installed by deploy/setup.sh.

[Unit]
Description=Set CPU governor to performance
DefaultDependencies=false
Before=lanthon-engine.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$cpu" 2>/dev/null || true; done'
RemainAfterExit=yes

[Install]
WantedBy=lanthon-engine.service
